# Normaliza a quebra de linha: LF no repositório e no working tree.
# O backend roda em containers Linux e o CI em Ubuntu; CRLF vindo do
# Windows fazia todo arquivo tocado aparecer como modificado por inteiro.
* text=auto eol=lf

# Arquivos que precisam de LF mesmo em ferramentas que fariam CRLF.
*.sh text eol=lf
Makefile text eol=lf

# Binários: sem conversão e sem diff textual.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
