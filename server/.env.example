# App
NODE_ENV="development"
PORT="3000"

# Database
DATABASE_URL="postgresql://postgres:postgres@database:5432/esliph_finance"
DATABASE_SSL="false"
DATABASE_POOL_MAX="10"

# Autenticação

## Segredo de assinatura dos tokens JWT (RNF005). Mínimo de 32 caracteres
JWT_SECRET="esliph-finance-development-secret-key"
## Validade do token de acesso, em segundos (RN005)
ACCESS_TOKEN_EXPIRES_IN_SECONDS="900"
## Validade do token de renovação, em segundos. Deve ser maior que a do token de acesso (RN006)
REFRESH_TOKEN_EXPIRES_IN_SECONDS="2592000"

# Security

## Origens aceitas pelo CORS, separadas por vírgula. "*" é rejeitado em produção
CORS_ORIGINS="*"
## Redireciona requisições HTTP para HTTPS (RNF007). Sempre "true" em produção
ENFORCE_HTTPS="false"
## Duração em segundos do header Strict-Transport-Security
HSTS_MAX_AGE="31536000"

# Docker

## Postgres
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="esliph_finance"
## Porta publicada no host. Precisa ser única entre cópias de trabalho que subam o banco ao mesmo tempo
POSTGRES_PORT="5432"

## Sufixo do nome do projeto no Compose. Vazio na raiz do repositório; em um worktree,
## defina algo como "-liph-46" para ganhar containers, volume e rede próprios — sem isso
## o worktree reaproveita o banco da raiz e os testes e2e de um apagam os dados do outro
STACK_SUFFIX=""
