{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "experimentalDecorators": true,
    "baseUrl": ".",
    "paths": {
      "@application/*": [
        "src/core/application/*"
      ],
      "@domain/*": [
        "src/core/domain/*"
      ],
      "@infrastructure/*": [
        "src/core/infrastructure/*"
      ],
      "@presentation/app/*": [
        "src/app/*"
      ],
      "@presentation/ui/*": [
        "src/ui/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
